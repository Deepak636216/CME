    {
      "id": "rules-t",
      "type": "text",
      "x": 70,
      "y": 710,
      "width": 843,
      "height": 104,
      "angle": 0,
      "autoResize": true,
      "backgroundColor": "transparent",
      "boundElements": null,
      "containerId": null,
      "fillStyle": "solid",
      "fontFamily": 3,
      "fontSize": 16,
      "frameId": null,
      "groupIds": [],
      "index": "aX",
      "isDeleted": false,
      "lineHeight": 1.25,
      "link": null,
      "locked": false,
      "opacity": 100,
      "originalText": "1  snapshot / delta / alert carry seq, strictly +1 across all three kinds\n2  ?since=n  ->  every message n+1 ...  OR a fresh snapshot; a snapshot always replaces state\n3  seq > n + 1  ->  client sends resync and ignores sequenced messages until a snapshot\n4  applying the same message twice changes nothing (upsert by id, series by t)\n5  a new alert arrives once as 'alert'; its later changes (clearing) come inside a delta",
      "roughness": 1,
      "roundness": null,
      "seed": 2108002265,
      "strokeColor": "#1e1e1e",
      "strokeStyle": "solid",
      "strokeWidth": 2,
      "text": "1  snapshot / delta / alert carry seq, strictly +1 across all three kinds\n2  ?since=n  ->  every message n+1 ...  OR a fresh snapshot; a snapshot always replaces state\n3  seq > n + 1  ->  client sends resync and ignores sequenced messages until a snapshot\n4  applying the same message twice changes nothing (upsert by id, series by t)\n5  a new alert arrives once as 'alert'; its later changes (clearing) come inside a delta",
      "textAlign": "left",
      "updated": 1791215028385,
      "version": 1,
      "versionNonce": 877679541,
      "verticalAlign": "top"
    },
