      "lineHeight": 1.25,
      "link": null,
      "locked": false,
      "opacity": 100,
      "originalText": "dbmAt(t, {v0, w, gamma, r0})   DBM distance, speed\ndbmTransitTime(input, 1 AU)    bisection on dbmAt\ndbmForecast({..., launchAt})   {eta, arrivalSpeed}\nnewell(v, by, bz)              coupling dPhi/dt\nclassFromFlux / fluxFromClass  9.96e-6 -> M1.0\nparseLocation / formatLocation N20E46 <-> lat, lon\nisEarthDirected(lat, lon, ha)  Earth in the cone\n\nAU_KM  R_SUN_KM  DONKI_R0_KM = 21.5 Rs\nDEFAULT_GAMMA = 0.2e-7 /km   SYNODIC 13.2 deg/day",
      "roughness": 1,
      "roundness": null,
      "seed": 537222750,
      "strokeColor": "#1e1e1e",
      "strokeStyle": "solid",
      "strokeWidth": 2,
      "text": "dbmAt(t, {v0, w, gamma, r0})   DBM distance, speed\ndbmTransitTime(input, 1 AU)    bisection on dbmAt\ndbmForecast({..., launchAt})   {eta, arrivalSpeed}\nnewell(v, by, bz)              coupling dPhi/dt\nclassFromFlux / fluxFromClass  9.96e-6 -> M1.0\nparseLocation / formatLocation N20E46 <-> lat, lon\nisEarthDirected(lat, lon, ha)  Earth in the cone\n\nAU_KM  R_SUN_KM  DONKI_R0_KM = 21.5 Rs\nDEFAULT_GAMMA = 0.2e-7 /km   SYNODIC 13.2 deg/day",
      "textAlign": "left",
      "updated": 1791215095120,
      "version": 1,
      "versionNonce": 660486488,
      "verticalAlign": "top"
    },
