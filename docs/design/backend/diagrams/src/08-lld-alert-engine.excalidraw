    {
      "id": "rules-t",
      "type": "text",
      "x": 1005,
      "y": 150,
      "width": 640,
      "height": 210,
      "angle": 0,
      "autoResize": true,
      "backgroundColor": "transparent",
      "boundElements": null,
      "containerId": null,
      "fillStyle": "solid",
      "fontFamily": 3,
      "fontSize": 15,
      "frameId": null,
      "groupIds": [],
      "index": "aE",
      "isDeleted": false,
      "lineHeight": 1.25,
      "link": null,
      "locked": false,
      "opacity": 100,
      "originalText": "Rule        Raise when                    Level    Clear when\nFLARE_M     running max >= 1e-5 W/m2      watch    flare ended\nFLARE_X     running max >= 1e-4 W/m2      warning  flare ended\nCME_EARTH   new/revised CME Earth-bound   warning  eta + 12 h\n                                                   (raised + 3 d if no eta)\nBZ_SOUTH    Bz <= -10 nT for 3 min        warning  Bz > -5 nT for 10 min\nFEED_STALE  a feed goes stale             watch    feed fresh again\nTEST        POST /admin/test-alert        watch    after 10 min\n\nid:  FLARE_*:<flareId>  CME_EARTH:<cmeId>  BZ_SOUTH:<first ts>\n     FEED_STALE:<feedId>  TEST:<ts>:<seq>",
      "roughness": 1,
      "roundness": null,
      "seed": 2108002265,
      "strokeColor": "#1e1e1e",
      "strokeStyle": "solid",
      "strokeWidth": 2,
      "text": "Rule        Raise when                    Level    Clear when\nFLARE_M     running max >= 1e-5 W/m2      watch    flare ended\nFLARE_X     running max >= 1e-4 W/m2      warning  flare ended\nCME_EARTH   new/revised CME Earth-bound   warning  eta + 12 h\n                                                   (raised + 3 d if no eta)\nBZ_SOUTH    Bz <= -10 nT for 3 min        warning  Bz > -5 nT for 10 min\nFEED_STALE  a feed goes stale             watch    feed fresh again\nTEST        POST /admin/test-alert        watch    after 10 min\n\nid:  FLARE_*:<flareId>  CME_EARTH:<cmeId>  BZ_SOUTH:<first ts>\n     FEED_STALE:<feedId>  TEST:<ts>:<seq>",
      "textAlign": "left",
      "updated": 1791213787198,
      "version": 1,
      "versionNonce": 877679541,
      "verticalAlign": "top"
    },
