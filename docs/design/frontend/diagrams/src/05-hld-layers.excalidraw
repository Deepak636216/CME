      "index": "aY",
      "isDeleted": false,
      "lineHeight": 1.25,
      "link": null,
      "locked": false,
      "opacity": 100,
      "originalText": "1  Never wait on the network to draw.\n   IndexedDB cache -> REST -> socket.\n\n2  60 fps without React.\n   Per-frame work in useFrame with\n   getState(), written via refs.\n   React re-renders ~1 / s.\n\n3  One writer per kind of state.\n   stream -> liveStore\n   user   -> useUi\n   alerts -> useAlerts\n\n4  Server time everywhere.\n   serverNow(clock, clockAt),\n   never the device clock.",
      "roughness": 1,
      "roundness": null,
      "seed": 2048826948,
      "strokeColor": "#1e1e1e",
      "strokeStyle": "solid",
      "strokeWidth": 2,
      "text": "1  Never wait on the network to draw.\n   IndexedDB cache -> REST -> socket.\n\n2  60 fps without React.\n   Per-frame work in useFrame with\n   getState(), written via refs.\n   React re-renders ~1 / s.\n\n3  One writer per kind of state.\n   stream -> liveStore\n   user   -> useUi\n   alerts -> useAlerts\n\n4  Server time everywhere.\n   serverNow(clock, clockAt),\n   never the device clock.",
      "textAlign": "left",
      "updated": 1791214561441,
      "version": 1,
      "versionNonce": 1027514766,
      "verticalAlign": "top"
    },
